# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- uv ---
# uv.lock is intentionally tracked for reproducibility

# --- Jupyter ---
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- Project data (regeneratable from USGS API) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet
*.geojson

# --- Outputs ---
figures/*.png
figures/*.pdf
figures/*.svg
!figures/.gitkeep
report/*.pdf
!report/.gitkeep

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Logs / temp ---
*.log
*.tmp
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
